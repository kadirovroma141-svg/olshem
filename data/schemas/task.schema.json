{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Task",
 "type": "array",
 "minItems": 1,
 "items": {
  "type": "object",
  "required": [
   "id",
   "grade",
   "topic",
   "difficulty",
   "languages",
   "source",
   "validationStatus"
  ],
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^ST-\\d{4}$"
   },
   "grade": {
    "enum": [
     10,
     11
    ]
   },
   "topic": {
    "type": "string"
   },
   "subtopic": {
    "type": "string"
   },
   "difficulty": {
    "type": "integer",
    "minimum": 1,
    "maximum": 5
   },
   "languages": {
    "type": "object",
    "required": [
     "kk",
     "ru",
     "en"
    ],
    "additionalProperties": false,
    "properties": {
     "kk": {
      "type": "object",
      "required": [
       "title",
       "statement"
      ],
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1
       },
       "statement": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "ru": {
      "type": "object",
      "required": [
       "title",
       "statement"
      ],
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1
       },
       "statement": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "en": {
      "type": "object",
      "required": [
       "title",
       "statement"
      ],
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1
       },
       "statement": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   },
   "source": {
    "type": "object",
    "required": [
     "type",
     "citation",
     "rightsStatus"
    ],
    "properties": {
     "type": {
      "enum": [
       "original",
       "open",
       "licensed",
       "textbook"
      ]
     },
     "citation": {
      "type": [
       "string",
       "null"
      ]
     },
     "rightsStatus": {
      "type": "string"
     }
    }
   },
   "validationStatus": {
    "enum": [
     "pending",
     "auto_validated",
     "validated"
    ]
   }
  }
 }
}
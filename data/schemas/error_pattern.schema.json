{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "ErrorPattern",
 "type": "array",
 "minItems": 1,
 "items": {
  "type": "object",
  "required": [
   "code",
   "taskId",
   "wrongExpression",
   "languages",
   "validationStatus"
  ],
  "properties": {
   "code": {
    "type": "string",
    "pattern": "^ERR-[A-Z-]+$"
   },
   "taskId": {
    "type": "string"
   },
   "wrongExpression": {
    "type": "string"
   },
   "relatedRules": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "languages": {
    "type": "object",
    "required": [
     "kk",
     "ru",
     "en"
    ],
    "additionalProperties": false,
    "properties": {
     "kk": {
      "type": "object",
      "required": [
       "title",
       "hint",
       "selfCheck"
      ],
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1
       },
       "hint": {
        "type": "string",
        "minLength": 1
       },
       "selfCheck": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "ru": {
      "type": "object",
      "required": [
       "title",
       "hint",
       "selfCheck"
      ],
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1
       },
       "hint": {
        "type": "string",
        "minLength": 1
       },
       "selfCheck": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "en": {
      "type": "object",
      "required": [
       "title",
       "hint",
       "selfCheck"
      ],
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1
       },
       "hint": {
        "type": "string",
        "minLength": 1
       },
       "selfCheck": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   },
   "validationStatus": {
    "enum": [
     "pending",
     "auto_validated",
     "validated"
    ]
   }
  }
 }
}
{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Rule",
 "type": "array",
 "minItems": 1,
 "items": {
  "type": "object",
  "required": [
   "id",
   "type",
   "languages",
   "dependencies",
   "source",
   "validationStatus"
  ],
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^RULE-\\d{3}$"
   },
   "type": {
    "enum": [
     "axiom",
     "definition",
     "theorem",
     "formula",
     "method"
    ]
   },
   "languages": {
    "type": "object",
    "required": [
     "kk",
     "ru",
     "en"
    ],
    "additionalProperties": false,
    "properties": {
     "kk": {
      "type": "object",
      "required": [
       "title",
       "statement"
      ],
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1
       },
       "statement": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "ru": {
      "type": "object",
      "required": [
       "title",
       "statement"
      ],
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1
       },
       "statement": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "en": {
      "type": "object",
      "required": [
       "title",
       "statement"
      ],
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1
       },
       "statement": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   },
   "dependencies": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "source": {
    "type": "object",
    "required": [
     "type",
     "citation",
     "rightsStatus"
    ],
    "properties": {
     "type": {
      "enum": [
       "original",
       "open",
       "licensed",
       "textbook"
      ]
     },
     "citation": {
      "type": [
       "string",
       "null"
      ]
     },
     "rightsStatus": {
      "type": "string"
     }
    }
   },
   "validationStatus": {
    "enum": [
     "pending",
     "auto_validated",
     "validated"
    ]
   }
  }
 }
}